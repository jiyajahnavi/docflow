# MySQL Database URL (format: mysql+pymysql://<user>:<password>@<host>:<port>/<database>)
DATABASE_URL=mysql+pymysql://docflow:DocFlow123!@localhost:3306/docflow_db

# Google OAuth 2.0 Credentials
# Get these from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Application Security
# Generate a secure key in production (e.g., openssl rand -hex 32)
SECRET_KEY=dev-secret-key-change-in-production-docflow-ems-2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256
